# Local IdP inputs for the Kustomize Secret generators.

issuers:
  - name: event-bus
    issuer: http://172.18.200.1
    kid: event-bus
    ttlSeconds: 3600
    signingKeyBase64: <<DEMOIDP_EVENT_BUS_SIGNING_KEY_BASE64>>
    clients:
      - id: mqtt-client
        secret: mqtt-client-secret
        grantType: client_credentials
        audience: dsx-exchange
        claims:
          sub: mqtt-client
          azp: mqtt-client
      - id: mqtt-publisher
        secret: mqtt-publisher-secret
        grantType: client_credentials
        audience: dsx-exchange
        claims:
          sub: mqtt-publisher
          azp: mqtt-publisher
      - id: mqtt-subscriber
        secret: mqtt-subscriber-secret
        grantType: client_credentials
        audience: dsx-exchange
        claims:
          sub: mqtt-subscriber
          azp: mqtt-subscriber
      - id: launchlayer-client
        secret: launchlayer-client-secret
        grantType: client_credentials
        audience: dsx-exchange
        claims:
          sub: launchlayer-client
          azp: launchlayer-client
    users: []

  - name: human-oidc
    replicas: 1
    port: 5556
    issuer: http://human-oidc.idp.svc.cluster.local:5556
    kid: human-oidc
    ttlSeconds: 3600
    # Keep local JWKS stable across redeploys.
    signingKeyBase64: <<DEMOIDP_HUMAN_OIDC_SIGNING_KEY_BASE64>>
    podAnnotations: {}
    podSecurityContext:
      runAsNonRoot: true
    securityContext:
      readOnlyRootFilesystem: true
      allowPrivilegeEscalation: false
      capabilities:
        drop: [ALL]
    clients:
      - id: dsx-agent-gateway
        secret: <<DEMOIDP_CLIENT_SECRET>>
      - id: wrong-audience
        secret: <<DEMOIDP_CLIENT_SECRET>>
      # Lets auth tests request an issuer-signed expired JWT.
      - id: expired-token
        secret: <<DEMOIDP_CLIENT_SECRET>>
        audience: dsx-agent-gateway
        ttlSeconds: -300
    users:
      - username: operator@local
        password: <<DEMOIDP_OPERATOR_PASSWORD>>
        claims:
          sub: operator
          email: operator-renamed@local
          email_verified: true
          name: operator
          preferred_username: operator
      - username: viewer@local
        password: <<DEMOIDP_VIEWER_PASSWORD>>
        claims:
          sub: viewer
          email: viewer@local
          email_verified: true
          name: viewer
          preferred_username: viewer

  - name: service-oidc
    replicas: 1
    port: 5556
    issuer: http://service-oidc.idp.svc.cluster.local:5556
    kid: service-oidc
    ttlSeconds: 3600
    # Keep local JWKS stable across redeploys.
    signingKeyBase64: <<DEMOIDP_SERVICE_OIDC_SIGNING_KEY_BASE64>>
    podAnnotations: {}
    podSecurityContext:
      runAsNonRoot: true
    securityContext:
      readOnlyRootFilesystem: true
      allowPrivilegeEscalation: false
      capabilities:
        drop: [ALL]
    clients:
      - id: service-agent
        secret: <<DEMOIDP_CLIENT_SECRET>>
        grantType: client_credentials
        audiences: [dsx-agent-gateway, fixture-other]
        claims:
          sub: service-agent
      - id: wrong-audience
        secret: <<DEMOIDP_CLIENT_SECRET>>
        grantType: client_credentials
        audiences: [wrong-audience, fixture-other]
        claims:
          sub: service-agent
    users: []

  - name: svid-issuer
    replicas: 1
    port: 5556
    issuer: http://svid-issuer.idp.svc.cluster.local:5556
    kid: svid-issuer
    ttlSeconds: 3600
    # Keep local JWKS stable across redeploys.
    signingKeyBase64: <<DEMOIDP_SVID_SIGNING_KEY_BASE64>>
    podAnnotations: {}
    podSecurityContext:
      runAsNonRoot: true
    securityContext:
      readOnlyRootFilesystem: true
      allowPrivilegeEscalation: false
      capabilities:
        drop: [ALL]
    clients:
      - id: dsx-agent-gateway
        secret: <<DEMOIDP_CLIENT_SECRET>>
      - id: wrong-audience
        secret: <<DEMOIDP_CLIENT_SECRET>>
      # Lets auth tests request an issuer-signed expired JWT.
      - id: expired-token
        secret: <<DEMOIDP_CLIENT_SECRET>>
        audience: dsx-agent-gateway
        ttlSeconds: -300
    users:
      - username: tenant-a@local
        password: <<DEMOIDP_TENANT_A_PASSWORD>>
        claims:
          sub: spiffe://tenant-a/agent/tenant-a@local
          email: tenant-a@local
      - username: tenant-b@local
        password: <<DEMOIDP_TENANT_B_PASSWORD>>
        claims:
          sub: spiffe://tenant-b/agent/tenant-b@local
          email: tenant-b@local
      - username: tenant-c@local
        password: <<DEMOIDP_TENANT_C_PASSWORD>>
        claims:
          sub: spiffe://tenant-c/agent/tenant-c@local
          email: tenant-c@local
      - username: tenant-test@local
        password: <<DEMOIDP_TENANT_TEST_PASSWORD>>
        claims:
          sub: spiffe://tenant-test/agent/tenant-test@local
          email: tenant-test@local
      - username: tenant-test-b@local
        password: <<DEMOIDP_TENANT_TEST_B_PASSWORD>>
        claims:
          sub: spiffe://tenant-test-b/agent/tenant-test-b@local
          email: tenant-test-b@local
      - username: bad-svid@local
        password: <<DEMOIDP_BAD_SVID_PASSWORD>>
        claims:
          sub: tenant-a/agent/bad-svid@local
          email: bad-svid@local

  - name: svid-wrong-key
    replicas: 1
    port: 5556
    # Claims the configured issuer but signs with a different JWKS.
    issuer: http://svid-issuer.idp.svc.cluster.local:5556
    kid: svid-issuer
    ttlSeconds: 3600
    signingKeyBase64: <<DEMOIDP_SVID_WRONG_KEY_SIGNING_KEY_BASE64>>
    podAnnotations: {}
    podSecurityContext:
      runAsNonRoot: true
    securityContext:
      readOnlyRootFilesystem: true
      allowPrivilegeEscalation: false
      capabilities:
        drop: [ALL]
    clients:
      - id: dsx-agent-gateway
        secret: <<DEMOIDP_CLIENT_SECRET>>
    users:
      - username: tenant-a@local
        password: <<DEMOIDP_TENANT_A_PASSWORD>>
        claims:
          sub: spiffe://tenant-a/agent/tenant-a@local
          email: tenant-a@local

  - name: unconfigured-issuer
    replicas: 1
    port: 5556
    # Signs tokens from an issuer the gateway does not trust.
    issuer: http://unconfigured-issuer.idp.svc.cluster.local:5556
    kid: unconfigured-issuer
    ttlSeconds: 3600
    signingKeyBase64: <<DEMOIDP_UNCONFIGURED_SIGNING_KEY_BASE64>>
    podAnnotations: {}
    podSecurityContext:
      runAsNonRoot: true
    securityContext:
      readOnlyRootFilesystem: true
      allowPrivilegeEscalation: false
      capabilities:
        drop: [ALL]
    clients:
      - id: dsx-agent-gateway
        secret: <<DEMOIDP_CLIENT_SECRET>>
    users:
      - username: tenant-a@local
        password: <<DEMOIDP_TENANT_A_PASSWORD>>
        claims:
          sub: spiffe://tenant-a/agent/tenant-a@local
          email: tenant-a@local
